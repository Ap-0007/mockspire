# Copy this file to ".env" in the server/ folder and fill in your own values.
# Never commit the real .env file.

# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/mockspire
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mockspire
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWTs. Use a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret

# Gemini API key (create one in Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key